{
  "name": "abroadster",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8081",
    "lint": "tsc --noEmit",
    "seed:schools": "node scripts/_export-programs.mjs && node scripts/seed-schools-catalog.mjs",
    "eas:whoami": "expo whoami",
    "eas:login": "eas-cli login",
    "eas:init": "eas-cli init",
    "eas:build:android": "eas-cli build --platform android --profile preview",
    "eas:build:android:production": "eas-cli build --platform android --profile production",
    "eas:submit:android": "eas-cli submit --platform android --profile production --latest",
    "eas:build:ios": "eas-cli build --platform ios --profile preview",
    "eas:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/eas-push-setup.ps1",
    "legal:generate": "node scripts/generate-legal-html.mjs",
    "legal:host": "node scripts/generate-legal-html.mjs && node scripts/host-legal-supabase.mjs",
    "play:feature-graphic": "node scripts/generate-play-feature-graphic.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.9",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@rnmapbox/maps": "^10.3.5",
    "@supabase/supabase-js": "^2.110.8",
    "@types/mapbox-gl": "^3.4.1",
    "expo": "~57.0.12",
    "expo-age-range": "^57.0.3",
    "expo-asset": "~57.0.10",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.9",
    "expo-media-library": "~57.0.3",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "mapbox-gl": "^3.26.0",
    "maplibre-gl": "^5.21.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.4",
    "eas-cli": "^16.32.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets",
        "expo-font",
        "typescript"
      ]
    }
  }
}
