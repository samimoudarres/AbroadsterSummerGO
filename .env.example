# Get a free Mapbox token (takes ~2 minutes):
# 1. Go to https://account.mapbox.com/auth/signup/
# 2. Create a free account
# 3. Open https://account.mapbox.com/access-tokens/
# 4. Copy your Default Public Token (starts with pk.)
# 5. Paste it below after the = sign
# 6. Restart the app (stop and run npm run web again)

EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Supabase (Community chat backend). Leave blank to use local demo mode.
# Use the Project URL + publishable key (safe for the app). Never put sb_secret_ in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT still works if you prefer it:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Logo.dev publishable key for higher-quality school logos.
# Without this, Google favicons are used (works with zero setup).
# https://www.logo.dev → copy publishable key → restart app / re-run:
#   node scripts/seed-schools-catalog.mjs
# Optional: public origin where /terms and /privacy are hosted (App Store / Play listing URL).
# After you deploy Expo web or public/legal, set e.g.:
# EXPO_PUBLIC_LEGAL_BASE_URL=https://your-domain.com
EXPO_PUBLIC_LEGAL_BASE_URL=
